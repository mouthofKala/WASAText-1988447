FROM node:lts AS builder

### Copy Vue.js code
WORKDIR /app

### Build Vue.js into plain HTML/CSS/JS
RUN corepack enable
COPY webui/ ./
RUN yarn install
RUN yarn run vite build --mode production

EXPOSE 4173

### Copy the (built) app from the builder image
# COPY --from=builder /app/dist /usr/share/nginx/html
CMD ["yarn", "run", "vite", "preview", "--host", "0.0.0.0", "--port", "4173", "--strictPort"]